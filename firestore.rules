rules_version = '2';

// Firestore security rules for the Project & Resource Monitoring Application.
//
// Deploy with:  firebase deploy --only firestore:rules
// Schema:       docs/SCHEMA.md
//
// Shape of these rules:
//
//   - Everything is denied unless a rule below allows it.
//   - Organisation data is readable only by members of that organisation.
//   - Projects, squads and signals are READ-ONLY to clients. They are written
//     by ingestion, never by the app, which is what stops a team editing its
//     own health scores.
//   - Settings are the one thing a team may write, so scoring weights can be
//     tuned from the app.
//   - Comments on a signal are written by people, as themselves, and are
//     locked down to four fields so they cannot carry anything else.
//
// This matters more here than in most projects: google-services.json is
// committed, so the Firebase config is available to anyone with repository
// access. These rules are the only thing protecting the data.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reads the caller's own user document to find their organisation.
    // Costs one document read per rule evaluation, which Firestore caches
    // within a single request.
    function callerOrgId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId;
    }

    // The caller's role, as stored on their own user document. Roles are
    // raised in the console, never by the app, so this cannot be
    // self-assigned.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function belongsToOrg(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && callerOrgId() == orgId;
    }

    // ---------------------------------------------------------------------
    // Users
    // ---------------------------------------------------------------------
    match /users/{userId} {
      // A user reads only their own profile. Reading other members would
      // expose who is in a squad, which the whole design avoids.
      allow read: if isSelf(userId);

      // Registration creates the caller's own document. The role is pinned to
      // developer here so an account cannot grant itself a higher one; raising
      // a role is done in the console.
      allow create: if isSelf(userId)
        && request.resource.data.role == 'developer'
        && request.resource.data.orgId is string;

      // Display name only. Changing your own orgId or role is not a thing.
      allow update: if isSelf(userId)
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Organisations
    // ---------------------------------------------------------------------
    match /organisations/{orgId} {
      allow read: if belongsToOrg(orgId);
      allow write: if false; // created server-side or in the console

      // -------------------------------------------------------------------
      // Monitoring data — readable by members, written only by ingestion.
      // -------------------------------------------------------------------
      match /projects/{projectId} {
        allow read: if belongsToOrg(orgId);
        allow write: if false;
      }

      match /squads/{squadId} {
        allow read: if belongsToOrg(orgId);
        allow write: if false;
      }

      match /signals/{signalId} {
        allow read: if belongsToOrg(orgId);
        allow write: if false;

        // The discussion about why a signal fired. The one collection in the
        // app that people write and that carries a name, so it is fenced in
        // here rather than only by convention in the client:
        //
        //   - You may only post as yourself, so a comment cannot be
        //     attributed to somebody who did not write it.
        //   - Exactly four fields are accepted. Anything else — a squad id, a
        //     score, an activity count — is refused outright, so a comment
        //     can never become a side channel for individual data.
        //   - No editing, by anybody. A discussion that can be rewritten
        //     after the fact is not a record of what was decided.
        //   - You may delete your own comment and nobody else's.
        //
        // maxLength here repeats CommentRules.maxLength in
        // lib/models/comment.dart. Change one, change both.
        match /comments/{commentId} {
          allow read: if belongsToOrg(orgId);

          allow create: if belongsToOrg(orgId)
            && request.resource.data.keys().hasOnly(
                 ['body', 'authorId', 'authorName', 'createdAt'])
            && request.resource.data.keys().hasAll(
                 ['body', 'authorId', 'authorName', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 1000
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() <= 80
            && request.resource.data.createdAt == request.time;

          allow update: if false;

          allow delete: if belongsToOrg(orgId)
            && resource.data.authorId == request.auth.uid;
        }
      }

      match /outages/{outageId} {
        allow read: if belongsToOrg(orgId);
        // Teams without a schedule feed enter windows by hand, so this one is
        // writable by members.
        allow write: if belongsToOrg(orgId);
      }

      // -------------------------------------------------------------------
      // Configuration — writable by the team.
      // -------------------------------------------------------------------
      match /sources/{sourceId} {
        allow read: if belongsToOrg(orgId);
        // Connecting a source changes what the whole organisation is measured
        // on, so it matches the gate on the connect-source route.
        allow write: if belongsToOrg(orgId)
          && callerRole() != 'developer'
          // Tokens belong to the backend. Refuse any document carrying one,
          // rather than trusting the client not to send it.
          && !request.resource.data.keys().hasAny(['token', 'accessToken', 'apiKey']);
      }

      // Every member reads the settings, because the scoring has to be
      // inspectable by the people it scores. Only a lead or a manager changes
      // them. The client checks this too, so it can say why it refused — this
      // is what makes that check more than a courtesy.
      match /settings/{settingId} {
        allow read: if belongsToOrg(orgId);
        allow write: if belongsToOrg(orgId) && callerRole() != 'developer';
      }
    }
  }
}
