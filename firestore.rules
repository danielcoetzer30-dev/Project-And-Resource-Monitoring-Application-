rules_version = '2';

// Firestore security rules for the Project & Resource Monitoring Application.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Default posture is closed. The app currently runs entirely on
// MockProjectRepository and neither reads nor writes Firestore, so denying
// everything costs no functionality. Collections get opened deliberately, one
// at a time, as the real data layer is built.
//
// This matters more here than in most projects: the repository is public and
// google-services.json is committed, so the Firebase config is freely
// available. These rules are the only thing protecting the database.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers — commented out until auth exists, so deploys stay warning-free.
    // Uncomment these together with the rules that call them.
    // ---------------------------------------------------------------------

    // Is the request from a signed-in user?
    // function isSignedIn() {
    //   return request.auth != null;
    // }

    // Does the signed-in user belong to the organisation owning this data?
    // Reads the caller's own user document to find their organisation.
    // function belongsToOrg(orgId) {
    //   return isSignedIn()
    //     && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;
    // }

    // ---------------------------------------------------------------------
    // Default deny. Anything not explicitly matched below is refused.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Planned rules — intentionally commented out.
    //
    // Uncomment each block as the corresponding feature is built, and only
    // after the anonymiser is in place. Ingested data must already be
    // aggregated to squad level before it reaches Firestore; these rules
    // control who may read it, not whether it should have been stored.
    // ---------------------------------------------------------------------

    // A user may read and update only their own profile.
    // match /users/{userId} {
    //   allow read: if isSignedIn() && request.auth.uid == userId;
    //   allow update: if isSignedIn() && request.auth.uid == userId;
    //   allow create, delete: if false; // handled server-side
    // }

    // Organisation members may read their organisation.
    // match /organisations/{orgId} {
    //   allow read: if belongsToOrg(orgId);
    //   allow write: if false; // handled server-side
    // }

    // Projects, squads and signals are readable by the owning organisation.
    // All three are written by ingestion, never by a client, so client writes
    // stay closed — this is also what stops anyone editing their own scores.
    // match /organisations/{orgId}/projects/{projectId} {
    //   allow read: if belongsToOrg(orgId);
    //   allow write: if false;
    // }

    // match /organisations/{orgId}/squads/{squadId} {
    //   allow read: if belongsToOrg(orgId);
    //   allow write: if false;
    // }

    // match /organisations/{orgId}/signals/{signalId} {
    //   allow read: if belongsToOrg(orgId);
    //   allow write: if false;
    // }

    // Scoring weights are the one thing a team may tune themselves.
    // match /organisations/{orgId}/settings/{settingId} {
    //   allow read: if belongsToOrg(orgId);
    //   allow write: if belongsToOrg(orgId);
    // }
  }
}
