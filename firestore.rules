rules_version = '2';

// Firestore security rules for the Project & Resource Monitoring Application.
//
// Deploy with:  firebase deploy --only firestore:rules
// Schema:       docs/SCHEMA.md
//
// Shape of these rules:
//
//   - Everything is denied unless a rule below allows it.
//   - Organisation data is readable only by members of that organisation.
//   - Projects, squads and signals are READ-ONLY to clients. They are written
//     by ingestion, never by the app, which is what stops a team editing its
//     own health scores.
//   - Settings are the one thing a team may write, so scoring weights can be
//     tuned from the app.
//   - Comments on a signal are written by people, as themselves, and are
//     locked down to four fields so they cannot carry anything else.
//   - Messaging (direct messages and groups) is written by people too. Group
//     permissions follow the role ranking and are enforced here, not just in
//     the client. See the Messaging section below.
//
// This matters more here than in most projects: google-services.json is
// committed, so the Firebase config is available to anyone with repository
// access. These rules are the only thing protecting the data.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reads the caller's own user document to find their organisation.
    // Costs one document read per rule evaluation, which Firestore caches
    // within a single request.
    function callerOrgId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId;
    }

    // The caller's role, as stored on their own user document. Roles are
    // raised in the console, never by the app, so this cannot be
    // self-assigned.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // The caller's display name, as stored on their own user document. Used to
    // stop a directory entry carrying somebody else's name.
    function callerName() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName;
    }

    function belongsToOrg(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && callerOrgId() == orgId;
    }

    // ---------------------------------------------------------------------
    // Users
    // ---------------------------------------------------------------------
    match /users/{userId} {
      // A user reads only their own profile. Reading other members would
      // expose who is in a squad, which the whole design avoids.
      allow read: if isSelf(userId);

      // Registration creates the caller's own document. The role is pinned to
      // developer here so an account cannot grant itself a higher one; raising
      // a role is done in the console.
      allow create: if isSelf(userId)
        && request.resource.data.role == 'developer'
        && request.resource.data.orgId is string;

      // Display name only. Changing your own orgId or role is not a thing.
      allow update: if isSelf(userId)
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Organisations
    // ---------------------------------------------------------------------
    match /organisations/{orgId} {
      allow read: if belongsToOrg(orgId);
      allow write: if false; // created server-side or in the console

      // -------------------------------------------------------------------
      // Monitoring data — readable by members, written only by ingestion.
      // -------------------------------------------------------------------
      match /projects/{projectId} {
        allow read: if belongsToOrg(orgId);
        allow write: if false;
      }

      match /squads/{squadId} {
        allow read: if belongsToOrg(orgId);
        allow write: if false;
      }

      match /signals/{signalId} {
        allow read: if belongsToOrg(orgId);
        allow write: if false;

        // The discussion about why a signal fired. The one collection in the
        // app that people write and that carries a name, so it is fenced in
        // here rather than only by convention in the client:
        //
        //   - You may only post as yourself, so a comment cannot be
        //     attributed to somebody who did not write it.
        //   - Exactly four fields are accepted. Anything else — a squad id, a
        //     score, an activity count — is refused outright, so a comment
        //     can never become a side channel for individual data.
        //   - No editing, by anybody. A discussion that can be rewritten
        //     after the fact is not a record of what was decided.
        //   - You may delete your own comment and nobody else's.
        //
        // maxLength here repeats CommentRules.maxLength in
        // lib/models/comment.dart. Change one, change both.
        match /comments/{commentId} {
          allow read: if belongsToOrg(orgId);

          allow create: if belongsToOrg(orgId)
            && request.resource.data.keys().hasOnly(
                 ['body', 'authorId', 'authorName', 'createdAt'])
            && request.resource.data.keys().hasAll(
                 ['body', 'authorId', 'authorName', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 1000
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() <= 80
            && request.resource.data.createdAt == request.time;

          allow update: if false;

          allow delete: if belongsToOrg(orgId)
            && resource.data.authorId == request.auth.uid;
        }
      }

      match /outages/{outageId} {
        allow read: if belongsToOrg(orgId);
        // Teams without a schedule feed enter windows by hand, so this one is
        // writable by members.
        allow write: if belongsToOrg(orgId);
      }

      // -------------------------------------------------------------------
      // Configuration — writable by the team.
      // -------------------------------------------------------------------
      match /sources/{sourceId} {
        allow read: if belongsToOrg(orgId);
        // Connecting a source changes what the whole organisation is measured
        // on, so it matches the gate on the connect-source route.
        allow write: if belongsToOrg(orgId)
          && callerRole() != 'developer'
          // Tokens belong to the backend. Refuse any document carrying one,
          // rather than trusting the client not to send it.
          && !request.resource.data.keys().hasAny(['token', 'accessToken', 'apiKey']);
      }

      // Every member reads the settings, because the scoring has to be
      // inspectable by the people it scores. Only a lead or a manager changes
      // them. The client checks this too, so it can say why it refused — this
      // is what makes that check more than a courtesy.
      // A project's stated figures, as opposed to its measured ones: budget,
      // dates, rostered hours. Ingestion reads these and cannot invent them —
      // a commit log does not know what a project costs.
      //
      // Separate from projects/ on purpose. That collection is ingestion's
      // output and unwritable by every client, which is what stops a team
      // editing its own scores. Keeping the plan in the same document would
      // open that door; keeping it here does not.
      //
      // Nothing here flatters a score. Spending more of a budget always makes
      // the score worse, and a longer schedule lowers the burn rate but
      // lengthens the delivery forecast.
      // This is how a project comes into existence. Ingestion reads a plan
      // and produces the `projects` document from it, which is what lets the
      // app offer project setup while `projects` stays unwritable above.
      //
      // Exactly these fields, and no more. A plan that could carry a score, a
      // factor list or a seam would be the read-only rule above defeated by
      // the back door.
      //
      // maxName and maxClient repeat ProjectPlanRules in
      // lib/models/project_plan.dart. Change one, change both.
      match /projectPlans/{projectId} {
        allow read: if belongsToOrg(orgId);

        allow write: if belongsToOrg(orgId)
          && callerRole() != 'developer'
          && request.resource.data.keys().hasOnly([
               'name', 'client', 'squadId',
               'budgetTotal', 'budgetSpent',
               'startDate', 'endDate',
               'weeklyHours', 'isArchived'
             ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.client.size() <= 80
          && request.resource.data.squadId is string
          // Money and hours cannot be negative. A negative spend would make a
          // burn rate read as a team being paid to work.
          && request.resource.data.budgetTotal >= 0
          && request.resource.data.budgetSpent >= 0
          && request.resource.data.weeklyHours >= 0;

        // Archiving is the removal. Deleting the plan would orphan the
        // project document ingestion built from it, and the history is the
        // research record.
        allow delete: if false;
      }

      // Who is on which squad.
      //
      // The one collection in this app that attaches a person to a squad, and
      // a deliberate reversal taken on 21 October 2026. The cost is written
      // out in lib/models/squad_member.dart: a roster beside published squad
      // metrics re-identifies, which is the objection that turned the same
      // idea down a fortnight earlier. What these rules still hold on to:
      //
      //   - One field, `squadId`, and nothing else. A placement carrying a
      //     name, an hours figure or an activity count is refused outright,
      //     so this cannot become per-person measurement by the back door.
      //     The name and role on screen are read from the directory.
      //   - Only somebody who strictly outranks you may move you. A manager
      //     places leads and developers, a lead places developers, and nobody
      //     places a manager — not even themselves. A developer's rank is 0,
      //     so the comparison alone refuses them; there is no separate check.
      //   - Roles come from the real `users` documents, never from the
      //     directory, which is a display copy a person writes about
      //     themselves.
      //   - The squad has to exist, or a typo would create a roster nothing
      //     on the dashboard corresponds to.
      //   - No delete. Taking somebody off a squad writes an empty squadId,
      //     so a placement stays a record of a decision somebody made.
      //
      // This repeats SquadRosterRules in lib/models/squad_member.dart.
      // Change one, change both.
      match /squadMembers/{userId} {

        function roleOf(id) {
          return get(/databases/$(database)/documents/users/$(id)).data.role;
        }

        // 2 manager, 1 lead, 0 anything else. Same ladder as messaging.
        function rankOf(role) {
          return role == 'manager' ? 2 : (role == 'lead' ? 1 : 0);
        }

        function targetInThisOrg() {
          return get(/databases/$(database)/documents/users/$(userId)).data.orgId == orgId;
        }

        function squadExists(squadId) {
          return squadId == ''
            || exists(/databases/$(database)/documents/organisations/$(orgId)/squads/$(squadId));
        }

        allow read: if belongsToOrg(orgId);

        allow create, update: if belongsToOrg(orgId)
          && targetInThisOrg()
          && rankOf(callerRole()) > rankOf(roleOf(userId))
          && request.resource.data.keys().hasOnly(['squadId'])
          && request.resource.data.keys().hasAll(['squadId'])
          && request.resource.data.squadId is string
          && squadExists(request.resource.data.squadId);

        allow delete: if false;
      }

      match /settings/{settingId} {
        allow read: if belongsToOrg(orgId);
        allow write: if belongsToOrg(orgId) && callerRole() != 'developer';
      }

      // -------------------------------------------------------------------
      // Messaging — direct messages and groups.
      // -------------------------------------------------------------------
      //
      // Roles rank developer < lead < manager, and the rules below are the
      // ones in lib/models/messaging_rules.dart:
      //
      //   - Anybody in the organisation can message anybody else directly,
      //     whether or not they share a group.
      //   - Only a lead or a manager creates a group or adds somebody to one.
      //   - Anybody can leave a group. Removing somebody else needs a strictly
      //     higher role than theirs, so a manager can remove a lead or a
      //     developer, a lead can remove a developer, and nobody can remove
      //     their own rank or above.
      //   - Only members read a conversation or its messages. Removing
      //     somebody takes their access away at once.
      //   - Messages cannot be edited or deleted by anybody.
      //
      // Roles are always read from the real `users` documents, never from the
      // directory, which is a display copy a person writes about themselves.
      //
      // The `users` rule above is unchanged: it still stops anybody listing
      // the organisation. The directory is how people find each other to
      // message, and it carries a name and a role and nothing else.

      match /directory/{userId} {
        allow read: if belongsToOrg(orgId);

        // You write only your own entry, with exactly two fields. The role
        // and the name must match your real user document, so an entry cannot
        // claim a higher role or borrow somebody else's name.
        allow create, update: if isSelf(userId)
          && belongsToOrg(orgId)
          && request.resource.data.keys().hasOnly(['displayName', 'role'])
          && request.resource.data.keys().hasAll(['displayName', 'role'])
          && request.resource.data.role == callerRole()
          && request.resource.data.displayName == callerName()
          && request.resource.data.displayName.size() > 0;

        allow delete: if false;
      }

      match /conversations/{conversationId} {

        function roleOf(userId) {
          return get(/databases/$(database)/documents/users/$(userId)).data.role;
        }

        // 2 manager, 1 lead, 0 anything else.
        function rankOf(role) {
          return role == 'manager' ? 2 : (role == 'lead' ? 1 : 0);
        }

        function inThisOrg(userId) {
          return get(/databases/$(database)/documents/users/$(userId)).data.orgId == orgId;
        }

        function isLeadOrManager() {
          return callerRole() in ['lead', 'manager'];
        }

        // Whether somebody is in a conversation, read from the conversation
        // itself. Also used by the messages below.
        function isMemberOf(id) {
          return request.auth.uid in get(/databases/$(database)/documents/organisations/$(orgId)/conversations/$(id)).data.memberIds;
        }

        // Leaving is always allowed. Removing somebody else needs a strictly
        // higher rank, so equal ranks cannot remove each other.
        function mayRemove(targetId) {
          return targetId == request.auth.uid
            || rankOf(callerRole()) > rankOf(roleOf(targetId));
        }

        // A direct conversation between the caller and one other person in
        // the same organisation. The id is the two uids joined by an
        // underscore, so the same pair cannot end up with two conversations
        // through the app.
        function isNewDirect() {
          let data = request.resource.data;
          return data.keys().hasOnly(['kind', 'memberIds', 'createdBy', 'createdAt', 'lastMessageAt'])
            && data.keys().hasAll(['kind', 'memberIds', 'createdBy', 'createdAt', 'lastMessageAt'])
            && data.kind == 'direct'
            && data.createdBy == request.auth.uid
            && data.memberIds.size() == 2
            && data.memberIds[0] != data.memberIds[1]
            && request.auth.uid in data.memberIds
            && (conversationId == data.memberIds[0] + '_' + data.memberIds[1]
                || conversationId == data.memberIds[1] + '_' + data.memberIds[0])
            && inThisOrg(data.memberIds[0] == request.auth.uid ? data.memberIds[1] : data.memberIds[0])
            && data.createdAt == request.time
            && data.lastMessageAt == request.time;
        }

        // A group, made by a lead or a manager, with the creator as its only
        // member. Everybody else is added one at a time afterwards, because a
        // rule can check one person's organisation per write and cannot loop
        // over a list.
        //
        // maxLength here repeats MessagingRules.maxGroupNameLength in
        // lib/models/messaging_rules.dart. Change one, change both.
        function isNewGroup() {
          let data = request.resource.data;
          return data.keys().hasOnly(['kind', 'name', 'memberIds', 'createdBy', 'createdAt', 'lastMessageAt'])
            && data.keys().hasAll(['kind', 'name', 'memberIds', 'createdBy', 'createdAt', 'lastMessageAt'])
            && data.kind == 'group'
            && isLeadOrManager()
            && data.createdBy == request.auth.uid
            && data.memberIds == [request.auth.uid]
            && data.name is string
            && data.name.size() > 0
            && data.name.size() <= 60
            && data.createdAt == request.time
            && data.lastMessageAt == request.time;
        }

        // Any member bumping the last-activity time, which is what sending a
        // message does. Nothing else about the conversation may change.
        function isTouch() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt'])
            && request.resource.data.lastMessageAt == request.time;
        }

        // A lead or a manager adding exactly one person, appended to the end,
        // who must belong to this organisation and not already be in.
        //
        // The 50 repeats MessagingRules.maxGroupSize.
        function isAddition() {
          let before = resource.data.memberIds;
          let after = request.resource.data.memberIds;
          return resource.data.kind == 'group'
            && isLeadOrManager()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && after.size() == before.size() + 1
            && after.size() <= 50
            && after[0:before.size()] == before
            && !(after[before.size()] in before)
            && inThisOrg(after[before.size()]);
        }

        // Exactly one person leaving or being removed, allowed only under
        // mayRemove above.
        function isRemoval() {
          let before = resource.data.memberIds;
          let after = request.resource.data.memberIds;
          return resource.data.kind == 'group'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && after.size() == before.size() - 1
            && before.hasAll(after)
            && mayRemove(before.removeAll(after)[0]);
        }

        // Members only. Reading a conversation that does not exist is allowed
        // so the app can ask whether a direct conversation is there yet; it
        // returns nothing, so it reveals nothing.
        allow read: if belongsToOrg(orgId)
          && (resource == null || request.auth.uid in resource.data.memberIds);

        allow create: if belongsToOrg(orgId) && (isNewDirect() || isNewGroup());

        allow update: if belongsToOrg(orgId)
          && request.auth.uid in resource.data.memberIds
          && (isTouch() || isAddition() || isRemoval());

        // A conversation is a record, so it is never deleted.
        allow delete: if false;

        // Four fields only, written as yourself, never edited. Anything else,
        // such as a squad id or a score, is refused outright, so a message can
        // never become a side channel for individual data.
        //
        // maxLength here repeats MessagingRules.maxMessageLength in
        // lib/models/messaging_rules.dart. Change one, change both.
        match /messages/{messageId} {
          allow read: if belongsToOrg(orgId) && isMemberOf(conversationId);

          allow create: if belongsToOrg(orgId)
            && isMemberOf(conversationId)
            && request.resource.data.keys().hasOnly(['body', 'senderId', 'senderName', 'createdAt'])
            && request.resource.data.keys().hasAll(['body', 'senderId', 'senderName', 'createdAt'])
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 2000
            && request.resource.data.senderName is string
            && request.resource.data.senderName.size() <= 80
            && request.resource.data.createdAt == request.time;

          allow update, delete: if false;
        }
      }
    }
  }
}
