# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
 
# Local editor and tooling settings
.claude/ 

# Machine-specific, generated by the Flutter tool on each developer's machine
android/local.properties
ios/Flutter/Generated.xcconfig

# Service-account keys. Ingestion authenticates with one; it must never be
# committed. It lives in a GitHub Actions secret and nowhere else.
*-service-account*.json
service-account*.json
firebase-adminsdk*.json

# Backups written by tool/remove_seed_projects.dart. Local records of what
# was deleted, not something the repository needs.
seed-removal-backup-*.json
